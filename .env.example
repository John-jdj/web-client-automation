NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never expose to the browser.
SUPABASE_SECRET_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ — this key must never reach
# the browser. Restrict it to the Places API in the Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# When true (default) and GOOGLE_MAPS_API_KEY is not set, discovery returns
# clearly-labeled fictional mock businesses instead of failing. Ignored
# once a real API key is configured.
DEMO_MODE=true

# Server-only. Used by lib/ai/anthropic.ts for lead analysis. Never prefix
# with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Centralized AI model configuration (lib/ai/config.ts). Optional — sensible
# defaults are used if unset.
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4096

# Server-only. Used by lib/vercel/deploy-adapter.ts to deploy generated
# demos (Step 9). Never prefix with NEXT_PUBLIC_. While DEMO_MODE=true
# (above), these are not required — deployment uses a deterministic mock
# instead of calling the real Vercel API.
#
# VERCEL_TOKEN: a Vercel personal/team API token with deploy access —
#   create one at https://vercel.com/account/tokens.
# VERCEL_ORG_ID: the team/org id deployments are created under (optional
#   for a personal account project — omit if not using a team).
# VERCEL_PROJECT_ID: the existing Vercel project demos are deployed into.
#   One shared project is used for every demo (each deployment is just a
#   new build within it) — this app never creates a Vercel project or a
#   GitHub repository per business.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
