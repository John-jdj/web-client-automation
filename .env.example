NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — the Supabase service-role key. Bypasses Row Level Security
# entirely. Never prefix with NEXT_PUBLIC_, never expose to the browser,
# never log it, never return it from an API response. Used by
# lib/supabase/service.ts's createServiceClient(), which only two things
# in this app are allowed to call:
#   - the signed-token outreach unsubscribe route (app/api/outreach/unsubscribe),
#     the one legitimately unauthenticated caller in the app;
#   - lib/automation/context.ts's getServiceContext(), used by the
#     automation runner (lib/automation/run-automation.ts) so scheduled/
#     cron execution can run without a browser session (Step 11.2) — RLS
#     itself is never disabled or weakened; this is a separate, narrowly
#     scoped trusted code path, not a replacement for the normal
#     cookie-based client every route/page still uses by default.
SUPABASE_SECRET_KEY=

# Server-only. Authenticates GET/POST /api/automation/run (Step 11.3) —
# the endpoint the Vercel Cron schedule in vercel.json (Step 11.5) calls
# daily to trigger one automation cycle. Never prefix with NEXT_PUBLIC_.
# Required as `Authorization: Bearer <value>`; the route fails closed
# (500, runs nothing) if this is unset, and rejects every request (401)
# if it's set but the header doesn't match — compared with a
# constant-time check, never a plain `===`. Generate one with:
#   openssl rand -hex 32
#
# Vercel Cron deployment note: vercel.json's `crons` config has no field
# for custom headers, so it can never carry this secret — Vercel's
# scheduler only ever auto-attaches an `Authorization: Bearer <value>`
# header on its own if your Vercel project also has an env var literally
# named CRON_SECRET (Vercel's own reserved convention, unrelated to this
# app's code). To let Vercel's daily cron request authenticate
# successfully, set CRON_SECRET in the Vercel project's environment
# variables to the EXACT SAME VALUE as AUTOMATION_CRON_SECRET below —
# this is a deployment-time duplication done entirely in Vercel's env var
# settings, never in source code, vercel.json, or a query parameter.
AUTOMATION_CRON_SECRET=

# Server-only. Never prefix with NEXT_PUBLIC_ — this key must never reach
# the browser. Restrict it to the Places API in the Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# When true (default) and GOOGLE_MAPS_API_KEY is not set, discovery returns
# clearly-labeled fictional mock businesses instead of failing. Ignored
# once a real API key is configured.
DEMO_MODE=true

# Server-only. Used by lib/ai/anthropic.ts for lead analysis. Never prefix
# with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Centralized AI model configuration (lib/ai/config.ts). Optional — sensible
# defaults are used if unset.
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4096

# Server-only. Used by lib/vercel/deploy-adapter.ts to deploy generated
# demos (Step 9). Never prefix with NEXT_PUBLIC_. While DEMO_MODE=true
# (above), these are not required — deployment uses a deterministic mock
# instead of calling the real Vercel API.
#
# VERCEL_TOKEN: a Vercel personal/team API token with deploy access —
#   create one at https://vercel.com/account/tokens.
# VERCEL_ORG_ID: the team/org id deployments are created under (optional
#   for a personal account project — omit if not using a team).
# VERCEL_PROJECT_ID: the existing Vercel project demos are deployed into.
#   One shared project is used for every demo (each deployment is just a
#   new build within it) — this app never creates a Vercel project or a
#   GitHub repository per business.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Server-only. Used by lib/email/send-email.ts to send approved outreach
# messages (Step 10). Never prefix with NEXT_PUBLIC_. While DEMO_MODE=true
# (above), these are not required — sending uses a deterministic mock and
# never contacts a real email provider, and outreach itself is further
# gated by automation_settings.auto_outreach_enabled (false by default)
# and per-message approval — never sent automatically.
#
# RESEND_API_KEY: an API key from https://resend.com/api-keys.
# EMAIL_FROM: the verified sender address/domain configured in Resend
#   (e.g. "Agency Name <hello@yourdomain.com>").
# EMAIL_REPLY_TO: optional reply-to address, if different from EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Server-only. Used by lib/outreach/unsubscribe-token.ts to sign/verify the
# unsubscribe link included in every outreach email (Step 10.1). Never
# prefix with NEXT_PUBLIC_ — anyone with this value could forge a token for
# an arbitrary message id. While DEMO_MODE=true, a fixed non-secret
# fallback is used automatically so generation/tests need no setup; once
# DEMO_MODE=false, a real send FAILS SAFELY (no email goes out) if this is
# not set, rather than emailing an insecure or unsigned unsubscribe link.
# Generate one with: openssl rand -hex 32
OUTREACH_UNSUBSCRIBE_SECRET=

# Optional. How long a signed unsubscribe link stays valid, in days.
# Defaults to 30 if unset.
OUTREACH_UNSUBSCRIBE_TOKEN_TTL_DAYS=30

# Server-only. The app's own public base URL, used to build the absolute
# unsubscribe link (e.g. "https://yourdomain.com") embedded in outreach
# emails. Not a secret, but deliberately not NEXT_PUBLIC_ since it's only
# ever read on the server when composing an email. While DEMO_MODE=true
# this defaults to http://localhost:3000 (harmless — DEMO_MODE never sends
# a real email); once DEMO_MODE=false, a real send fails safely if this is
# unset, so a broken unsubscribe link is never mailed to a real recipient.
APP_URL=
